# ============================================================================
# Secrai environment. Copy to .env.local and fill in. NEVER commit .env.local.
# ============================================================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Service role bypasses RLS. SERVER ONLY. Used by the sync job to write findings.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# --- Microsoft Entra ID app registration (multi-tenant) ---
# Application (client) ID of the app you register in Entra admin center.
MS_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Client secret value (Certificates & secrets). Prefer a certificate in prod.
MS_CLIENT_SECRET=YOUR_CLIENT_SECRET
# Redirect URI registered on the app; must match exactly.
MS_REDIRECT_URI=http://localhost:3000/api/microsoft/callback
# 'common' or 'organizations' for multi-tenant admin consent.
MS_AUTHORITY_HOST=https://login.microsoftonline.com

# --- Token encryption ---
# 32-byte key, base64. Generate: openssl rand -base64 32
SECRAI_ENCRYPTION_KEY=CHANGE_ME_base64_32_bytes

# --- Sync scheduler ---
# Shared secret required to call /api/sync and /api/cron. Generate a long random string.
SYNC_SECRET=CHANGE_ME_long_random_string
